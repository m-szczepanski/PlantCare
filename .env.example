# PlantCare environment configuration.
# Copy to .env and adjust; docker compose loads it automatically.
# All values below are the defaults the containers assume when unset.

# --- api ---

# EF Core connection string for the API (SQLite by default).
# The default points at the plant-data volume mounted under /data.
DB_CONNECTIONSTRING=Data Source=/data/plantcare.db

# Directory the API writes uploaded plant photos to. In Docker it lives on the
# plant-photos volume (/data/uploads in the api, mounted into nginx as
# /usr/share/nginx/html/uploads and served under /uploads/). Override for bare
# local runs, e.g. PHOTO_STORAGE_PATH=uploads.
PHOTO_STORAGE_PATH=/data/uploads

# Directory scanned at startup for drop-in user species: every *.json file (same
# shape as the bundled seed) adds profiles; existing names are skipped and broken
# files are logged, never fatal. Lives on the plant-data volume by default, so
# users can add files without rebuilding.
SEED_CUSTOM_PATH=/data/seed-custom

# Cron expression for the daily watering-check job (Coravel).
WATERING_CHECK_CRON=0 8 * * *

# Base URL of the ntfy server used for push notifications.
NTFY_URL=http://ntfy:80

# ntfy topic the API publishes watering reminders to.
NTFY_TOPIC=plant-care

# Quick actions: when QUICK_ACTION_SECRET is set, a watering digest for a single
# due plant carries an ntfy button that POSTs to /api/plants/{id}/quick-water?key=SECRET.
# QUICK_ACTION_URL_BASE is the public origin used to build the link (empty -> links only
# work relative to requests; leave unset to disable the button).
QUICK_ACTION_SECRET=
QUICK_ACTION_URL_BASE=

# Optional Telegram notification channel: set BOTH to enable; the daily digest is
# then also delivered to the chat (email stays unimplemented — needs an SMTP decision).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Feature flags.
# ENABLE_CARE_TIPS is read by the api container; set to false to hide the
# care tips section on the plant detail view (defaults to true when unset).
ENABLE_CARE_TIPS=true
